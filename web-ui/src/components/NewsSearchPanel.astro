---
---

<section class="rounded-[18px] border border-[rgba(19,76,136,0.08)] bg-[linear-gradient(180deg,rgba(255,255,255,0.98),rgba(246,250,255,0.95))] shadow-[0_10px_24px_rgba(57,92,154,0.06)]">
  <div class="p-2.5 sm:px-3 sm:py-2.5">
    <form id="news-form" class="grid gap-2">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-2.5">
        <div>
          <p class="mb-0.5 text-[0.52rem] font-bold uppercase tracking-[0.08em] text-[#6d7e98]">
            Your Briefing
          </p>
          <h2 class="m-0 text-[0.95rem] leading-[1.1] font-semibold text-[#154272]">Shape the feed</h2>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
          <div id="news-mode-toggle" class="inline-flex overflow-hidden rounded-lg border border-[rgba(93,112,141,0.28)] bg-white text-[0.7rem] font-bold text-[#35516f]">
            <button type="button" data-mode="discover" class="cursor-pointer px-2.5 py-1.5 transition data-[active=true]:bg-[#1a73e8] data-[active=true]:text-white" data-active="true">Top stories</button>
            <button type="button" data-mode="for_you" class="cursor-pointer px-2.5 py-1.5 transition data-[active=true]:bg-[#1a73e8] data-[active=true]:text-white">For you</button>
          </div>
          <button
            id="news-trending-btn"
            class="cursor-pointer rounded-lg border border-[rgba(93,112,141,0.28)] bg-white px-[9px] py-1.5 text-[0.72rem] font-bold text-[#35516f] disabled:cursor-wait disabled:opacity-70"
            type="button">Trending</button>
          <button
            id="news-run-btn"
            class="cursor-pointer rounded-lg border border-transparent bg-[#1a73e8] px-[9px] py-1.5 text-[0.72rem] font-bold text-white shadow-[0_5px_12px_rgba(26,115,232,0.18)] disabled:cursor-wait disabled:opacity-70"
            type="submit">Refresh</button>
        </div>
      </div>

      <div id="news-tags-row" class="flex flex-wrap items-center gap-1.5">
        <span class="mr-1 text-[0.56rem] font-bold uppercase tracking-[0.08em] text-[#60728f]">Topics</span>
        <button type="button" data-tag="" class="cursor-pointer rounded-full border border-[rgba(93,112,141,0.28)] bg-white px-2.5 py-1 text-[0.68rem] font-semibold text-[#35516f] transition data-[active=true]:border-[#1a73e8] data-[active=true]:bg-[#d8ecff] data-[active=true]:text-[#14679c]" data-active="true">All</button>
        <span id="news-tags-placeholder" class="text-[0.7rem] text-[#7a8aa6]">Loading tags…</span>
      </div>

      <div class="grid gap-2 lg:grid-cols-[minmax(0,1.65fr)_minmax(280px,0.9fr)]">
        <label class="grid gap-[3px]">
          <span class="text-[0.56rem] font-bold uppercase tracking-[0.08em] text-[#60728f]">Search</span>
          <input
            class="min-h-7 w-full rounded-lg border border-[rgba(84,112,153,0.22)] bg-[rgba(255,255,255,0.95)] px-2 py-[5px] text-[0.72rem] text-ink"
            id="news-query"
            name="query"
            placeholder="Search the feed (optional)"
          />
        </label>

        <div class="grid gap-1.5 sm:grid-cols-[1fr_auto]">
          <label class="grid gap-[3px]">
            <span class="text-[0.56rem] font-bold uppercase tracking-[0.08em] text-[#60728f]">Stories</span>
            <input
              class="min-h-7 w-full rounded-lg border border-[rgba(84,112,153,0.22)] bg-[rgba(255,255,255,0.95)] px-2 py-[5px] text-[0.72rem] text-ink"
              id="limit"
              name="limit"
              type="number"
              min="1"
              max="100"
              value="20"
            />
          </label>
          <div class="grid gap-[3px]">
            <span class="text-[0.56rem] font-bold uppercase tracking-[0.08em] text-[#60728f]">Window</span>
            <div id="news-window-toggle" class="inline-flex overflow-hidden rounded-lg border border-[rgba(84,112,153,0.22)] bg-white text-[0.68rem] font-semibold text-[#35516f]">
              <button type="button" data-window="24h" data-hours="24" class="cursor-pointer px-2 py-1 transition data-[active=true]:bg-[#1a73e8] data-[active=true]:text-white" data-active="true">24h</button>
              <button type="button" data-window="7d" data-hours="168" class="cursor-pointer px-2 py-1 transition data-[active=true]:bg-[#1a73e8] data-[active=true]:text-white">7d</button>
              <button type="button" data-window="30d" data-hours="720" class="cursor-pointer px-2 py-1 transition data-[active=true]:bg-[#1a73e8] data-[active=true]:text-white">30d</button>
            </div>
          </div>
        </div>
      </div>

      <details class="rounded-lg border border-[rgba(84,112,153,0.18)] bg-white px-2 py-1.5 text-[0.7rem] text-[#445b80]">
        <summary class="cursor-pointer select-none text-[0.6rem] font-bold uppercase tracking-[0.08em] text-[#60728f]">Advanced — pick sources</summary>
        <fieldset id="news-sources-list" class="m-0 mt-2 flex flex-wrap gap-[5px] border-0 p-0">
          <legend class="mb-0 w-full p-0 text-[0.56rem] font-bold uppercase tracking-[0.08em] text-[#60728f]">
            Sources <span id="news-sources-count" class="ml-1 text-[#94a2bd]"></span>
            <button id="news-sources-all" class="ml-2 cursor-pointer underline" type="button">all</button>
            <button id="news-sources-none" class="ml-1 cursor-pointer underline" type="button">none</button>
          </legend>
          <span id="news-sources-placeholder" class="text-[0.7rem] text-[#7a8aa6]">Loading sources…</span>
        </fieldset>
      </details>
    </form>
  </div>
</section>
